# --- secrets: never commit ---
*.pem
.env

# --- environments ---
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- data (too large for GitHub) ---
data/*
!data/README.md
*.json.gz
*.json
*.parquet
cache/

# --- reference annotation downloads (large; only the derived viz/site/data/gene_names.json is committed) ---
*.gtf
*.gtf.gz

# --- outputs ---
results/*
!results/.gitkeep
!results/README.md
models/*
!models/.gitkeep
# to commit the final model, use:  git add -f models/final_model.joblib

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
desktop.ini

# --- re-include the small committed test set (must stay last) ---
!data/sample/
!data/sample/*

# --- visualisation data (small, built by scripts/build_viz_data.py; must stay after *.json) ---
!viz/site/data/
!viz/site/data/*.json
